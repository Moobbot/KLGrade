# KLGrade API Configuration

# Environment mode: dev, staging, production
ENV=dev

# Server configuration
HOST_CONNECT=0.0.0.0
PORT=9000

# GPU configuration
DEVICE=cuda
CUDA_VISIBLE_DEVICES=0

# Python settings
PYTHONUNBUFFERED=1

# Model paths (relative to /app)
KNEE_MODEL=runs/detect/knee_yolo11n_20260217_134003/weights/best.pt
LESION_MODEL=runs/detect/lesion_8class_balanced/weights/best.pt

# Upload/Results folders (used when running in Docker)
UPLOAD_FOLDER=/app/uploads
RESULTS_FOLDER=/app/results
